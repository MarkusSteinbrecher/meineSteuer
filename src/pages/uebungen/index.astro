---
import Basis from '../../layouts/Basis.astro';
import { pfad } from '../../lib/site';
---
<Basis titel="Übungen" beschreibung="Steuererklärungen im Browser ausfüllen und üben, zum Beispiel für einen Kurs." bereich="uebungen">
  <header class="seite-kopf">
    <ol class="sd-breadcrumb" aria-label="Pfad"><li><a href={pfad()}>Start</a></li><li><span aria-current="page">Übungen</span></li></ol>
    <h1 class="seite-titel">Übungen</h1>
    <p class="seite-lede">Übungsfälle direkt im Browser ausfüllen: die amtlichen Formulare nachgebaut, mit Erklärungen, Höchstbeträgen und einer Prüfliste. Deine Eingaben bleiben auf deinem Gerät.</p>
  </header>
  <div class="uebersicht">
    <ol class="sd-steps">
      <li class="sd-step"><div class="sd-step__main">
        <a class="sd-step__title" href={pfad('uebungen/zh-2025')}>Steuererklärung Kanton Zürich 2025</a>
        <p class="sd-step__body">Formular 300 mit Wertschriftenverzeichnis, Berufsauslagen, Versicherungsprämien, Weiterbildung, Liegenschaften, Schulden, Krankheitskosten und Zuwendungen. Mit Schätzung der Bundessteuer.</p>
      </div></li>
    </ol>
  </div>
</Basis>
